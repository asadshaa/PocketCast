<Window x:Class="PhoneProjection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:PhoneProjection.ViewModels"
        xmlns:controls="clr-namespace:PhoneProjection.Controls"
        mc:Ignorable="d"
        Title="PhoneProjection — Low-Latency Android Screen Mirroring" Height="780" Width="980"
        MinHeight="680" MinWidth="860"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.DataContext>
        <viewmodels:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab Item Animation & Style -->
        <Style x:Key="NavTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#141E33"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource SignalAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Layered Background Animation -->
    <Grid>
        <!-- Layer 0: Phone-to-PC Wave Animation -->
        <controls:SignalWaveBackground x:Name="SignalBackground"/>

        <!-- Layer 1: Application Content Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header bar -->
                <RowDefinition Height="Auto"/>
                <!-- Main Content Tabs -->
                <RowDefinition Height="*"/>
                <!-- Status Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Background="#E60E1527" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <DockPanel LastChildFill="False">
                    <!-- Brand & Subtitle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PhoneProjection" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                <Border Background="{StaticResource ElevatedSurfaceBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Midnight Cast" FontSize="10" Foreground="{StaticResource SignalAccentBrush}" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Connect your phone. Cast to your desktop." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Main Action Buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶ Start Casting" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding StartMirroringCommand}" Margin="0,0,8,0"/>
                        <Button Content="↻ Restart" Style="{StaticResource WarningButton}" 
                                Command="{Binding RestartMirroringCommand}" Margin="0,0,8,0"/>
                        <Button Content="■ Stop" Style="{StaticResource DangerButton}" 
                                Command="{Binding StopMirroringCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT TABS -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="14,10,14,6">
                <!-- TAB 1: MIRRORING DASHBOARD -->
                <TabItem Header="Dashboard &amp; Display" Style="{StaticResource NavTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" MaxWidth="920">

                            <!-- CARD 1: Status Banner & Device Selection -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <TextBlock Text="ACTIVE STATUS &amp; CONNECTED DEVICE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SignalAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ReportedFpsText}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>

                                    <!-- Status Banner -->
                                    <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="12,10" Margin="0,0,0,12">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Device Picker -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" 
                                                  VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" Content="↻ Refresh Devices" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding RefreshDevicesCommand}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: Quality Presets & Fine Tuning -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="QUALITY PRESETS &amp; PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SignalAccentBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Presets Selector -->
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Quality Preset:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding PresetsList}" SelectedItem="{Binding SelectedPreset}"/>
                                            <TextBlock Text="{Binding SelectedPreset.Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- FPS Cap -->
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <TextBlock Text="FPS Cap:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}"/>
                                            <TextBlock Text="Target display cap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Video Buffer Delay -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Buffer Delay (ms):" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding VideoBufferMs, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="0 = Lowest latency" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom Parameter Inputs (visible only if Custom is selected) -->
                                    <Border Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="12" Margin="0,4,0,12" 
                                            Visibility="{Binding IsCustomPresetSelected, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Custom Max Size (px):" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding CustomMaxSize, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Custom Bitrate (Mbps):" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding CustomBitrateMbps, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,6,0,12"/>

                                    <!-- Window Display Toggles -->
                                    <WrapPanel>
                                        <CheckBox IsChecked="{Binding IsFullscreen}" Content="Fullscreen Mode (--fullscreen)" Margin="0,0,24,6"/>
                                        <CheckBox IsChecked="{Binding IsBorderless}" Content="Borderless Window (--window-borderless)" Margin="0,0,24,6"/>
                                        <CheckBox IsChecked="{Binding StayAwake}" Content="Keep Phone Awake (--stay-awake)" Margin="0,0,24,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: Audio Policy (Android 10 Notice) -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="AUDIO CONFIGURATION &amp; ANDROID 10 POLICY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SignalAccentBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Android 10 Note: Audio forwarding requires Android 11+. On Android 10, audio capture is strictly experimental and depends on individual app security policies." 
                                               Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding EnableAudio}" Content="Attempt Audio Forwarding (Experimental)" 
                                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AudioSources}" SelectedItem="{Binding SelectedAudioSource}" 
                                                  IsEnabled="{Binding EnableAudio}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 4: Live Diagnostics Logs -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Clear Logs" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding ClearLogsCommand}" Padding="8,4" FontSize="11"/>
                                        <TextBlock Text="LIVE PROCESS DIAGNOSTICS &amp; LOGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBox Text="{Binding LogOutput}" Background="#060A14" Foreground="{StaticResource SignalAccentBrush}" FontFamily="Consolas" 
                                             FontSize="11" Height="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="{StaticResource BorderBrush}" Padding="8"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: WI-FI WORKFLOW -->
                <TabItem Header="Wi-Fi (Wireless ADB)" Style="{StaticResource NavTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" MaxWidth="920">

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="WIRELESS ADB SETUP (SONY XPERIA XZ3 / ANDROID 10)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SignalAccentBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="To mirror over Wi-Fi without a physical cable:&#x0a;1. Connect your phone via USB cable once.&#x0a;2. Click 'Step 1: Enable TCP Mode on USB Phone' below.&#x0a;3. Unplug USB cable, verify phone IP on your local Wi-Fi, and click 'Connect Wi-Fi'." 
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" LineHeight="20" Margin="0,0,0,14"/>

                                    <Button Content="🔌 Step 1: Enable TCP Mode on USB Phone (Port 5555)" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding EnableUsbTcpIpCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                                    <TextBlock Text="CONNECT EXISTING WI-FI SESSION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SignalAccentBrush}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Phone IP Address:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding WifiIp, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Port:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding WifiPort, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="📶 Connect Wi-Fi" Style="{StaticResource PrimaryButton}" 
                                                Command="{Binding ConnectWifiCommand}" VerticalAlignment="Bottom" Margin="0,0,10,0"/>

                                        <Button Grid.Column="3" Content="Disconnect" Style="{StaticResource DangerButton}" 
                                                Command="{Binding DisconnectWifiCommand}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: SETTINGS & TOOLS -->
                <TabItem Header="Settings &amp; Tools" Style="{StaticResource NavTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12" MaxWidth="920">

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="EXECUTABLE LOCATIONS &amp; OVERRIDES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SignalAccentBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="PhoneProjection automatically discovers scrcpy and ADB on your system. You can specify custom paths here if needed." 
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,14"/>

                                    <TextBlock Text="scrcpy.exe Path:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CustomScrcpyPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ResolvedScrcpyPath, StringFormat='Active: {0}'}" 
                                               Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,14"/>

                                    <TextBlock Text="adb.exe Path:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CustomAdbPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ResolvedAdbPath, StringFormat='Active: {0}'}" 
                                               Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- STATUS FOOTER -->
            <Border Grid.Row="2" Background="#E60E1527" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,8">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Shortcuts: F11 / Alt+Enter = Fullscreen | Alt+F = Window Fullscreen | Alt+Q = Quit scrcpy" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="Engine: scrcpy 4.1 (--no-control --video-buffer=0 --print-fps)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
